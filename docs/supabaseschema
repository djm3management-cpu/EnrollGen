### 3b. Embedding Helper

```javascript
// src/lib/embeddings.js

// Generate embedding for a copilot query
// Uses OpenAI — swap for Anthropic if/when embedding API is available
export async function getQueryEmbedding(text) {
  const response = await fetch('https://api.openai.com/v1/embeddings', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${import.meta.env.VITE_OPENAI_API_KEY}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      model: 'text-embedding-3-small',
      input: text,
    }),
  });

  const data = await response.json();
  return data.data[0].embedding; // 1536-dim vector
}
```

### 3c. Copilot Search Hook

```javascript
// src/hooks/useCopilotSearch.js
import { useState, useCallback } from 'react';
import { supabase } from '../lib/supabase';
import { getQueryEmbedding } from '../lib/embeddings';

export function useCopilotSearch() {
  const [results, setResults] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const searchTranscripts = useCallback(async ({
    query,
    productLine = null,    // 'MA' | 'MedSup' | 'ACA' | 'Ancillary'
    carrier = null,
    disposition = null,    // 'enrolled' to bias toward successful calls
    topics = null,         // ['objection_handling', 'closing']
    matchCount = 5,
    similarityThreshold = 0.7,
  }) => {
    setLoading(true);
    setError(null);

    try {
      // 1. Generate embedding for the agent's question
      const embedding = await getQueryEmbedding(query);

      // 2. Call the Supabase RPC function
      const { data, error: rpcError } = await supabase.rpc(
        'search_transcript_chunks',
        {
          query_embedding: embedding,
          match_count: matchCount,
          filter_product_line: productLine,
          filter_carrier: carrier,
          filter_disposition: disposition,
          filter_topics: topics,
          similarity_threshold: similarityThreshold,
        }
      );

      if (rpcError) throw rpcError;

      setResults(data || []);
      return data || [];
    } catch (err) {
      setError(err.message);
      console.error('Copilot search error:', err);
      return [];
    } finally {
      setLoading(false);
    }
  }, []);

  return { results, loading, error, searchTranscripts };
}
```

### 3d. Copilot Context Builder

This is the key piece — it takes search results and formats them as context for the AI prompt that powers EnrollGen's copilot responses.

```javascript
// src/lib/copilotContext.js

/**
 * Builds a context block from transcript search results
 * to inject into the copilot's system/user prompt.
 */
export function buildCopilotContext(searchResults) {
  if (!searchResults || searchResults.length === 0) {
    return '';
  }

  const contextBlocks = searchResults.map((result, i) => {
    const meta = [
      result.product_line,
      result.carrier,
      result.disposition,
      result.compliance_passed ? 'compliant' : 'flagged',
      new Date(result.call_date).toLocaleDateString(),
    ].filter(Boolean).join(' | ');

    return `--- Reference ${i + 1} [${meta}] ---
Speaker: ${result.speaker || 'unknown'}
Topics: ${(result.topics || []).join(', ')}
${result.chunk_text}`;
  });

  return `
<enrollment_call_references>
The following are excerpts from real enrollment calls relevant to the current situation.
Use these as reference for tone, compliance language, and handling approach.
Do NOT read these verbatim — adapt to the current conversation.

${contextBlocks.join('\n\n')}
</enrollment_call_references>`;
}
```

