## 5. PHI Scrubbing (Pre-Ingestion)

**Critical for Medicare compliance.** Run this BEFORE ingestion.

```javascript
// scripts/scrub-phi.js

const PHI_PATTERNS = [
  // Medicare Beneficiary Identifier (MBI) — format: 1A12-B34-CD56
  { pattern: /\d[A-Z]\d{2}-?[A-Z]\d{2}-?[A-Z]{2}\d{2}/gi, replacement: '[MBI_REDACTED]' },
  // SSN
  { pattern: /\b\d{3}-?\d{2}-?\d{4}\b/g, replacement: '[SSN_REDACTED]' },
  // Phone numbers
  { pattern: /\b\d{3}[-.)]\s?\d{3}[-.)]\s?\d{4}\b/g, replacement: '[PHONE_REDACTED]' },
  // Dates of birth (common spoken formats)
  { pattern: /\b(born|DOB|date of birth)[:\s]*([\d\/\-]+)/gi, replacement: '$1: [DOB_REDACTED]' },
  // Street addresses (basic — enhance for production)
  { pattern: /\b\d{1,5}\s+[\w\s]{2,30}(street|st|avenue|ave|road|rd|drive|dr|lane|ln|blvd|court|ct)\b/gi,
    replacement: '[ADDRESS_REDACTED]' },
  // Email
  { pattern: /\b[\w.-]+@[\w.-]+\.\w{2,}\b/g, replacement: '[EMAIL_REDACTED]' },
];

export function scrubPHI(transcriptText) {
  let scrubbed = transcriptText;
  for (const { pattern, replacement } of PHI_PATTERNS) {
    scrubbed = scrubbed.replace(pattern, replacement);
  }
  return scrubbed;
}
```

