## 4. Ingestion Pipeline (Node.js)

Run this as a standalone script or serverless function to process new transcripts.

```javascript
// scripts/ingest-transcript.js
import { createClient } from '@supabase/supabase-js';
import OpenAI from 'openai';

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY  // service role for writes
);

const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });

// --- Chunking ---
function chunkTranscript(text, maxTokens = 400, overlap = 50) {
  // Simple sentence-based chunking
  // For production: use a proper tokenizer (tiktoken)
  const sentences = text.split(/(?<=[.!?])\s+/);
  const chunks = [];
  let current = [];
  let currentLen = 0;

  for (const sentence of sentences) {
    const sentenceLen = sentence.split(/\s+/).length; // rough token count
    if (currentLen + sentenceLen > maxTokens && current.length > 0) {
      chunks.push(current.join(' '));
      // Keep last N words as overlap
      const overlapText = current.join(' ').split(/\s+/).slice(-overlap).join(' ');
      current = [overlapText, sentence];
      currentLen = overlap + sentenceLen;
    } else {
      current.push(sentence);
      currentLen += sentenceLen;
    }
  }
  if (current.length > 0) chunks.push(current.join(' '));
  return chunks;
}

// --- Speaker detection (basic) ---
function detectSpeaker(chunkText) {
  if (/^(agent|rep|advisor)/im.test(chunkText)) return 'agent';
  if (/^(caller|member|beneficiary|customer)/im.test(chunkText)) return 'beneficiary';
  return null;
}

// --- Topic tagging (keyword-based; upgrade to AI classification later) ---
const TOPIC_RULES = [
  { tag: 'scope_of_appointment', patterns: [/scope of appointment/i, /SOA/i, /permission to discuss/i] },
  { tag: 'plan_benefits', patterns: [/copay/i, /deductible/i, /formulary/i, /benefit/i, /coverage/i] },
  { tag: 'eligibility_verification', patterns: [/part [ab]/i, /medicaid/i, /LIS/i, /effective date/i] },
  { tag: 'objection_handling', patterns: [/not sure/i, /think about it/i, /happy with/i, /don't want/i] },
  { tag: 'sep_qualification', patterns: [/special enrollment/i, /SEP/i, /moved/i, /lost coverage/i] },
  { tag: 'prescription_review', patterns: [/medication/i, /prescription/i, /pharmacy/i, /drug/i] },
  { tag: 'provider_check', patterns: [/doctor/i, /specialist/i, /provider/i, /network/i] },
  { tag: 'premium_cost', patterns: [/premium/i, /\$\d/i, /cost/i, /part b/i, /giveback/i] },
  { tag: 'compliance_disclosure', patterns: [/recording/i, /cms/i, /disclaimer/i, /licensed/i] },
  { tag: 'closing', patterns: [/confirm/i, /recap/i, /enrollment complete/i, /effective/i] },
];

function tagTopics(text) {
  return TOPIC_RULES
    .filter(rule => rule.patterns.some(p => p.test(text)))
    .map(rule => rule.tag);
}

// --- Main ingestion ---
export async function ingestTranscript({
  agentId,
  callDate,
  durationSeconds,
  direction,
  productLine,
  carrier,
  planName,
  enrollmentPeriod,
  disposition,
  compliancePassed,
  transcriptText,
  sourceSystem = 'conversely',
  sourceId = null,
  recordingUrl = null,
}) {
  // 1. Insert parent transcript record
  const { data: transcript, error: txError } = await supabase
    .from('call_transcripts')
    .insert({
      agent_id: agentId,
      call_date: callDate,
      duration_seconds: durationSeconds,
      direction,
      product_line: productLine,
      carrier,
      plan_name: planName,
      enrollment_period: enrollmentPeriod,
      disposition,
      compliance_passed: compliancePassed,
      transcript_text: transcriptText,
      source_system: sourceSystem,
      source_id: sourceId,
      recording_url: recordingUrl,
      phi_scrubbed: true, // ensure PHI is stripped BEFORE calling this
    })
    .select('id')
    .single();

  if (txError) throw txError;

  // 2. Chunk the transcript
  const chunks = chunkTranscript(transcriptText);

  // 3. Generate embeddings for all chunks (batch)
  const embeddingResponse = await openai.embeddings.create({
    model: 'text-embedding-3-small',
    input: chunks,
  });

  // 4. Insert chunks with embeddings
  const chunkRecords = chunks.map((text, i) => ({
    transcript_id: transcript.id,
    chunk_index: i,
    chunk_text: text,
    speaker: detectSpeaker(text),
    topics: tagTopics(text),
    embedding: embeddingResponse.data[i].embedding,
  }));

  const { error: chunkError } = await supabase
    .from('transcript_chunks')
    .insert(chunkRecords);

  if (chunkError) throw chunkError;

  console.log(
    `Ingested transcript ${transcript.id}: ${chunks.length} chunks`
  );
  return transcript.id;
}
```

