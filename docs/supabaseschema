// Example: inside your existing copilot/script component
import { useCopilotSearch } from '../hooks/useCopilotSearch';
import { buildCopilotContext } from '../lib/copilotContext';

function CopilotPanel({ currentMode, currentStep, agentQuery }) {
  const { searchTranscripts, results, loading } = useCopilotSearch();

  async function handleCopilotQuery(query) {
    // Search for relevant transcript chunks
    const searchResults = await searchTranscripts({
      query: query,
      productLine: currentMode, // 'MA' or 'MedSup' from EnrollGen's mode toggle
      disposition: 'enrolled',  // bias toward successful calls
      matchCount: 3,
    });

    // Build context for the AI prompt
    const referenceContext = buildCopilotContext(searchResults);

    // Now pass referenceContext into your AI completion call
    // e.g., as part of the system prompt or user message
    const copilotResponse = await callCopilotAI({
      systemPrompt: `You are an enrollment assistant for NGHS agents.
        Current product: ${currentMode}
        Current script step: ${currentStep}
        ${referenceContext}`,
      userMessage: query,
    });

    return copilotResponse;
  }

  // ... render UI
}
