# integrations-worker on Railway; use a component-specific secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy rollout fallback.
SUPABASE_SERVICE_ROLE_KEY=
# Existing report/provider settings are separate from Supabase authentication.
RESEND_API_KEY=
INTEGRATIONS_REPORT_FROM=

# Compliance uploads: opt in only after migration 123 and provider validation.
CONVERSELY_UPLOAD_ENABLED=false
CONVERSELY_API_KEY=
TELEPHONY_BASE_URL=
# Closed Monday–Sunday ET week, sampled on the next worker run.
CONVERSELY_SAMPLES_PER_AGENT=1
CONVERSELY_CARRIERS=UnitedHealthcare,Devoted,WellCare,Zing,Anthem,Aetna,HealthSpring,Humana
# Stable agent slug, UUID or Clerk ID -> excluded carrier names/aliases.
CONVERSELY_AGENT_EXCLUSIONS={"mark_endres":["Humana"]}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
