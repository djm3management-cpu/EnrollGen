# Office Nextcloud sync: never expose the Supabase secret to browser clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
NEXTCLOUD_USER=
NEXTCLOUD_APP_TOKEN=
NEXTCLOUD_URL=http://nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1
DB_PASSWORD=
SUPABASE_SUMMARY_BUCKET=call-summaries
SUPABASE_TRANSCRIPT_BUCKET=call-transcripts
SUPABASE_SUMMARY_PATH_FIELDS=summary_pdf_path,call_summary_pdf_path,pdf_storage_path,metadata.summary_pdf_path,metadata.call_summary_pdf_path,metadata.summaryPdfPath,metadata.summary_pdf.storage_path,metadata.summaryPdf.storagePath
SUPABASE_TRANSCRIPT_PATH_FIELDS=transcript_storage_path,transcript_txt_path,raw_transcript_path,metadata.transcript_storage_path,metadata.transcript_txt_path,metadata.raw_transcript_path,metadata.transcript.storage_path,metadata.transcript.storagePath
SUPABASE_TRANSCRIPT_TEXT_FIELDS=transcript_raw,transcript_text,metadata.transcript_raw,metadata.transcript_text
