# Custom hosted Edge secret: SUPABASE_* is a reserved prefix.
# Prefer a component-specific API secret key.
ENROLLGEN_SUPABASE_SECRET_KEY=
# The platform also injects SUPABASE_SECRET_KEYS (JSON, named default).
# SUPABASE_SECRET_KEY is accepted if supplied by a local/runtime environment.
# SUPABASE_SERVICE_ROLE_KEY remains the last transition fallback.
PARAGON_STATE_ROUTING_ENABLED=false
PARAGON_PING_FIELD_MAP=
