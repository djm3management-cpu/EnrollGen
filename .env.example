# Server-side only. Never prefix provider keys with VITE_.
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# Co-Pilot provider controls below do not affect scoring, which always uses OPENAI_API_KEY.
LLM_PROVIDER=openai
# Empty engine overrides inherit LLM_PROVIDER; set anthropic for a single-engine rollback.
LLM_PROVIDER_MA=
LLM_PROVIDER_MEDSUP=
LLM_PROVIDER_ACA=
LLM_PROVIDER_U65=
# Empty disables fallback. Luna is the primary model.
LLM_FALLBACK_MODEL=gpt-5.6-terra
# Empty disables shadowing; enable with claude-sonnet-4-6.
LLM_SHADOW_MA=
LLM_SHADOW_MEDSUP=
LLM_SHADOW_ACA=
LLM_SHADOW_U65=
# Supabase admin connection: server-side only. New keys take precedence.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy transition fallback; remove after every runtime uses a new key.
SUPABASE_SERVICE_ROLE_KEY=
# Local-only CMS migration: supply one SQL-capable connection credential.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
PARAGON_STATE_ROUTING_ENABLED=false
PARAGON_PING_FIELD_MAP=
# Public API client used by the cms-plans Netlify function.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Browser/build-time configuration. Never put a secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Separate CMS project, if configured: use that project's public key.
VITE_SUPABASE_CMS_URL=
VITE_SUPABASE_CMS_PUBLISHABLE_KEY=
VITE_SUPABASE_CMS_ANON_KEY=
SCORE_CALL_JOB_SECRET=replace-with-internal-background-job-secret
