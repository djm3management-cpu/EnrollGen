# Server-side only. Never prefix provider keys with VITE_.
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
LLM_PROVIDER=openai
# Empty engine overrides inherit LLM_PROVIDER; set anthropic for a single-engine rollback.
LLM_PROVIDER_MA=
LLM_PROVIDER_MEDSUP=
LLM_PROVIDER_ACA=
LLM_PROVIDER_U65=
# Empty disables fallback. Luna is the primary model.
LLM_FALLBACK_MODEL=gpt-5.6-terra
# Empty disables shadowing; enable with claude-sonnet-4-6.
LLM_SHADOW_MA=
LLM_SHADOW_MEDSUP=
LLM_SHADOW_ACA=
LLM_SHADOW_U65=
# Existing telemetry connection (server-side).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
