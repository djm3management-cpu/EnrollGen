# TEMPLATE ONLY. Replace placeholders in private service configuration.
# Never put a server secret in VITE_. Optional integrations default off.

# Deployment identity, destinations, hours, browser security and admission limits
# Copy/adapt config/deployment-profile.example.json; supply its full JSON here.
# The profile is server-only and shared by build, Netlify, phone and worker.
DEPLOYMENT_PROFILE_JSON=replace-with-reviewed-deployment-profile-json
# Default Report-Only; set enforce only after browser acceptance, then rebuild.
CSP_MODE=report-only

# Clerk authentication (CLERK_JWT_KEY is a PUBLIC verification PEM, not private)
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_JWT_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Operator-only replay tool credential, never a browser/build setting.
CLERK_ADMIN_TOKEN=

# Supabase service identity; new secret key wins over legacy fallbacks
SUPABASE_URL=https://database.example
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# SQL-capable operator connection; never used by verify or test suites.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
# Browser keys are public; separate CMS project is optional.
VITE_SUPABASE_URL=https://database.example
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_CMS_URL=
VITE_SUPABASE_CMS_PUBLISHABLE_KEY=
VITE_SUPABASE_CMS_ANON_KEY=
VITE_ENABLE_CMS_SUPABASE=false

# OpenAI: only the openai provider is supported; blank engine overrides inherit
OPENAI_API_KEY=replace-with-openai-api-key
LLM_PROVIDER=openai
LLM_PROVIDER_MA=
LLM_PROVIDER_MEDSUP=
LLM_PROVIDER_ACA=
LLM_PROVIDER_U65=
LLM_PROVIDER_ANCILLARY=
LLM_PROVIDER_ANNUITY=
LLM_FALLBACK_MODEL=
# Explicit owner-approved small models, no general-model fallback for these jobs
RTS_INGESTION_OPENAI_MODEL=replace-with-approved-rts-openai-model
KNOWLEDGE_UPDATE_OPENAI_MODEL=replace-with-approved-knowledge-openai-model
ENROLLGEN_DEBUG_LOGS=false

# Feature switches: exactly true/false; unset/empty/false means disabled
PARAGON_ENABLED=false
PARAGON_STATE_ROUTING_ENABLED=false
GHL_ENABLED=false
STRIPE_BILLING_ENABLED=false
DAILY_VERSE_ENABLED=false
CONVERSELY_UPLOAD_ENABLED=false
IX_UPLOAD_ENABLED=false
IX_REPORT_ENABLED=false
CONFERENCE_CALLING_ENABLED=false
SCORING_ENABLED=false
TRANSCRIPT_GAP_FILL_ENABLED=false
TRANSCRIPT_AUTO_RECOVERY_ENABLED=false
OPERATIONAL_EMAIL_ENABLED=false
KNOWLEDGE_AUTO_UPDATE_ENABLED=false

# Telephony: one replica required; profile owns public base origin and sender
PORT=8080
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=replace-with-twilio-api-key-secret
TWILIO_TWIML_APP_SID=
# Fallback for direct-agent-number mapping only; profile owns agencyLine.
TWILIO_PHONE_NUMBER=
DIRECT_AGENT_NUMBERS=
AGENT_WS_SIGNING_SECRET=replace-with-independent-websocket-signing-secret
INBOUND_VENDOR_API_KEY=replace-with-vendor-api-key
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
STT_WAIT_FOR_ANSWER=true
MIN_CONNECTED_SECONDS=30
DIAL_TIMEOUT_SECONDS=20
STICKY_ROUTING_ENABLED=false
STICKY_LOOKBACK_DAYS=180
RECORDING_MAX_BYTES=268435456
RECORDING_STORAGE_MAX_BYTES=52428800
RECORDING_TIMEOUT_MS=60000
DELETE_TWILIO_RECORDINGS_AFTER_COPY=false
TRANSCRIPT_SCORING_URL=
VITE_INBOUND_CALLS_ENABLED=false
VITE_ENABLE_CUSTOMER_AUDIO=false
# Process/host replica controls, all must remain exactly one.
RAILWAY_REPLICA_COUNT=1
WEB_CONCURRENCY=1
TELEPHONY_REPLICAS=1
REPLICAS=1

# Scoring, scheduled/background jobs and knowledge proposals
SCORE_CALL_JOB_SECRET=replace-with-independent-background-job-secret
KNOWLEDGE_UPDATE_SECRET=replace-with-independent-knowledge-job-secret
BACKFILL_SECRET=replace-with-independent-backfill-secret
COMPLIANCE_RULES_VERSION=
SCORING_DAILY_TOKEN_CAP=2000000

# Vendors: destinations/identities are in the deployment profile, not env URLs
PARAGON_PING_FIELD_MAP=
CONVERSELY_API_KEY=replace-with-conversely-api-key
CONVERSELY_AGENT_EXCLUSIONS=
CONVERSELY_CARRIERS=
CONVERSELY_SAMPLES_PER_AGENT=
IX_USERNAME=
IX_PASSWORD=replace-with-ix-password
RESEND_API_KEY=replace-with-resend-api-key

# Stripe (optional billing); redirect fallback URLs are public application URLs
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-signing-secret
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
ENROLLGEN_APP_URL=https://app.example
SITE_URL=https://app.example

# Optional browser display, server-proxied GIF/Bible providers and public loaders
VITE_SHOW_ACA_REFERENCE_DETAILS=false
GIPHY_API_KEY=replace-with-giphy-api-key
BIBLIA_API_KEY=replace-with-biblia-api-key
HUD_USER_TOKEN=replace-with-hud-token
# Legacy rate-quote reader names: keep empty; public API keys fail the build guard.
VITE_CSG_API_URL=
VITE_CSG_API_KEY=
# Existing name-only public key exception; server BIBLIA_API_KEY is preferred.
VITE_BIBLIA_API_KEY=

# Optional standalone office sync container (not started or deployed by verify)
NEXTCLOUD_URL=https://office.example
NEXTCLOUD_USER=
NEXTCLOUD_APP_TOKEN=replace-with-nextcloud-app-token
SUPABASE_CALLS_TABLE=
SYNC_TIME_COLUMN=
SUPABASE_PAGE_SIZE=
SYNC_INTERVAL_SECONDS=
INITIAL_SYNC_SINCE=
ADVANCE_ON_MISSING_ARTIFACTS=false
SUPABASE_SUMMARY_BUCKET=
SUPABASE_TRANSCRIPT_BUCKET=
SUPABASE_SUMMARY_PATH_FIELDS=
SUPABASE_TRANSCRIPT_PATH_FIELDS=
SUPABASE_TRANSCRIPT_TEXT_FIELDS=
STATE_DB=
LOG_FILE=
RUN_ONCE=false

# Runtime-injected names read by the application; do not copy into private env:
# NODE_ENV, URL, NETLIFY, CONTEXT, DEPLOY_ID, RAILWAY_ENVIRONMENT,
# RAILWAY_ENVIRONMENT_ID, RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID,
# AWS_LAMBDA_FUNCTION_NAME, VERCEL, CI, PATH, SystemRoot.
# Vite injects DEV; it is not an operator setting.
# Retired auth switches are rejected even if empty and must stay absent:
# DISABLE_CLERK_AUTH, VITE_DISABLE_CLERK_AUTH, ALLOW_INSECURE_WEBHOOK_TESTS.

# Destructive retention job opt-in. Dry runs remain the default even when true.
RETENTION_PURGE_ENABLED=false

# Staff-only SOC 2 access review exception threshold (server only).
ACCESS_REVIEW_MAX_ADMINS=3
