# EnrollGen telephony service environment
# Copy to .env for local dev; set these in Railway/Fly for production.

# Server
PORT=8080
# Public HTTPS URL of this service (Railway/Fly domain). Used for Twilio
# signature validation and to build webhook/stream callback URLs.
PUBLIC_BASE_URL=https://enrollgen-telephony.up.railway.app
# Optional: restrict browser origins for the token endpoint (default *)
CORS_ALLOW_ORIGIN=https://app.enrollgen.example

# Supabase (server-only secret key; NEVER ship to client)
SUPABASE_URL=https://qzjtagnpklaxefwurorc.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback during rollout.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API key pair for minting Voice SDK access tokens (Twilio console > API keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID used by the Voice SDK grant
TWILIO_TWIML_APP_SID=
# The inbound number the FMO transfers to (E.164)
TWILIO_PHONE_NUMBER=

# Requires migration 121 and staging acceptance tests. Default off.
CONFERENCE_CALLING_ENABLED=false

# Enable only after migrations 051-053 and the edge function are deployed.
# Off preserves legacy call routing; Paragon pings report unavailable.
PARAGON_STATE_ROUTING_ENABLED=false
# Optional JSON mapping when Paragon publishes its final ping field names.
# Example: {"state":"caller_state","phone":"ani","call_id":"lead_id"}
PARAGON_PING_FIELD_MAP=

# Deepgram (server key, not the browser token flow)
DEEPGRAM_API_KEY=

# FMO lead intake auth: shared secret the vendor sends as x-api-key
INBOUND_VENDOR_API_KEY=

# Clerk backend key for verifying agent sessions on /api/voice/token
CLERK_SECRET_KEY=

# Secret for signing /agent WebSocket tokens (any long random string)
AGENT_WS_SIGNING_SECRET=

# Tenant routing (v1 is single tenant; defaults to NGHS)
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# Ring time per agent before rerouting (seconds)
DIAL_TIMEOUT_SECONDS=20

# GIPHY search and MMS picker (server-side only)
GIPHY_API_KEY=
