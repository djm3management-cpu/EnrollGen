{
  "name": "react-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ping-demo": "node scripts/ping/demo-env.mjs && vite --mode ping-demo --open /ping-demo.html",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import ./tests/fixtures/deployment-env.js --test tests/*.test.js",
    "test:opportunities": "node --test tests/opportunities.test.js",
    "test:migration": "node --test 'tests/migration/*.test.js'",
    "eval:copilot": "node scripts/evaluate-copilot-scenarios.mjs",
    "test:llm": "node --test tests/llm.test.js tests/copilot-prompts.test.js tests/copilot-silence.test.js tests/medsup-nj.test.js",
    "typecheck:llm": "tsc -p tsconfig.llm.json",
    "pilot:load:short": "node scripts/pilot/run-local.mjs",
    "pilot:load:long": "node scripts/pilot/run-local.mjs --long",
    "ping:load:short": "node scripts/ping_load.js --short",
    "ping:load:long": "node scripts/ping_load.js --long",
    "verify": "node scripts/verify.mjs",
    "recovery:backup": "node scripts/recovery/backup.mjs",
    "recovery:restore": "node scripts/recovery/restore.mjs",
    "recovery:drill": "node scripts/recovery/drill.mjs",
    "recovery:storage-check": "node scripts/recovery/storage-consistency.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.0",
    "@clerk/clerk-react": "^5.61.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@twilio/voice-sdk": "^2.18.3",
    "@workadventure/noise-suppression": "^0.2.0",
    "ajv": "^8.20.0",
    "framer-motion": "^12.34.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "openai": "^7.12.1",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "9.3.17",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "pg": "^8.16.3",
    "typescript": "^7.0.2",
    "vite": "^6.0.3"
  }
}
